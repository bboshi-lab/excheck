      "@infrastructure/*": ["./infrastructure/*"],
      "@worker/*": ["./worker/*"],
      "@app/*": ["./src/app/*"],
      "@presentation/*": ["./src/presentation/*"],
      "@ui/*": ["./src/presentation/ui/*"],
